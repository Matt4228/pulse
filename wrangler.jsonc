{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One trigger, every minute. The tick decides what is due (see src/scheduler.ts).
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulse",
      // Replaced with the real id from `npx wrangler d1 create pulse` at deploy time.
      "database_id": "3f2b4768-095d-4bff-b5e6-2efaf07734fc",
      "migrations_dir": "migrations"
    }
  ]
}
